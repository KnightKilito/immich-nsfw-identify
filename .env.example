# Host port for the local management page. The container listens on 2983.
NSFW_PORT=2983

# URL reachable from INSIDE the scanner container; include the /api suffix.
# Windows/macOS Docker Desktop: host.docker.internal points to the host.
IMMICH_API_URL=http://host.docker.internal:2283/api

# Business event logging: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Enter the user's API Key in the management page, not in this file.
